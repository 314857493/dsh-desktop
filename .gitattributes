# Normalize line endings for source files (checkout as LF).
* text=auto

*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.nsh text eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ico binary
*.png binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
